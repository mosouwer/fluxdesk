# ==============================================================================
# FluxDesk - Production Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development or configure these variables
# directly in your hosting platform (Vercel, AWS Amplify, Docker, Railway, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION BASE URL
# ------------------------------------------------------------------------------
# The fully-qualified public URL of your FluxDesk deployment without a trailing slash.
# Used for:
# - Embeddable widget script source (<script src=".../widget.js">)
# - Iframe embedding origin checks (/embed/chat)
# - Production redirect URLs and snippet generators
#
# Production Example: https://desk.yourdomain.com
# Local Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT URL
# ------------------------------------------------------------------------------
# Your Supabase Cloud project endpoint.
# Where to find:
# - Supabase Dashboard -> Project Settings -> API -> Project URL
#
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# ------------------------------------------------------------------------------
# 3. SUPABASE ANONYMOUS PUBLIC KEY
# ------------------------------------------------------------------------------
# The public client API key (anon key) for browser and client-side requests.
# Safe to expose to the browser. All client operations are protected by
# PostgreSQL Row Level Security (RLS) policies.
# Where to find:
# - Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon" (public)
#
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 4. SUPABASE SERVICE ROLE KEY (CRITICAL: SERVER-ONLY SECRET)
# ------------------------------------------------------------------------------
# The administrative service role secret key.
# IMPORTANT SECURITY NOTES:
# - NEVER expose this key to client-side bundles or prefix with NEXT_PUBLIC_.
# - NEVER commit this key to version control.
# - Used ONLY by server actions (@/utils/supabase/admin) for administrative tasks
#   (e.g., auth.admin.createUser, team agent invitations, super admin actions).
# Where to find:
# - Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "service_role" (secret)
#
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
